# Credentials only — the bot choice lives in the settings table (admin console).
# Azure AI Foundry / Azure OpenAI. Leave the API version blank to use the v1 API
# (https://<resource>.services.ai.azure.com/openai/v1 — a project URL works too).
# Fill it in only for the classic API (e.g. 2024-10-21).
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=

# ILMU — assumed OpenAI-compatible (/chat/completions, Bearer key). Leave blank = "not configured".
ILMU_BASE_URL=
ILMU_API_KEY=
ILMU_MODEL=

# Used only for the QR code in the admin console. Set it to wherever the app is really hosted.
PUBLIC_URL=https://warung-kita.siapstudio.my

ADMIN_PASSWORD=change-me

# How many model calls the whole room may have in flight at once (default 12).
# This is the most important number to get right, and it depends on the provider:
#   Azure  — raise it as far as the deployment's tokens-per-minute allows; past that you get 429s
#            (handled: they are waited out, not counted as failures).
#   ILMU   — keep it at or below 8, and 4 leaves margin. Its endpoint serves 8 concurrent requests
#            correctly and corrupts from 9: a 200 with a truncated body ({"pass) and finish_reason
#            "stop", as if it had answered. Measured with plain fetch, no SDK, so it is the
#            endpoint and not this app: 8 in flight x 300 requests = 0 bad, 9 = 63%, 12 = 81%.
MAX_CONCURRENT_CALLS=12
DATABASE_PATH=./data/warung-kita.db

# Set to 1 to offer the offline mock bot in the admin dropdown even when Azure is configured.
# (It is always used automatically when Azure isn't configured.)
ENABLE_MOCK=
